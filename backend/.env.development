# ==========================================
# Local Development Environment Template
# ==========================================
# Save this file as ".env" or ".env.local" in your backend directory
# when you want to run the app locally on your machine.
# Make sure your production .env is securely stored!

# 1. Environment Mode
NODE_ENV=development

# 2. Server Port
PORT=5000

# 3. MongoDB Connection
# Replace with your local MongoDB URI or a test Atlas cluster
MONGO_URI=mongodb://localhost:27017/rentify_local_test

# 4. JSON Web Token Secret
JWT_SECRET=local_development_super_secret_key_123!@#

# 5. Application URLs
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

# 6. CORS Settings
# If testing from another device on your network (like a phone),
# add its local IP to ALLOWED_ORIGINS here.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# ==========================================
# Optional / 3rd Party Integrations
# (Can be left blank or use test accounts)
# ==========================================

# Cloudinary
CLOUDINARY_CLOUD_NAME=test_cloud
CLOUDINARY_API_KEY=test_api_key
CLOUDINARY_API_SECRET=test_api_secret

# Google OAuth
GOOGLE_CLIENT_ID=test_client_id
GOOGLE_CLIENT_SECRET=test_client_secret

# Email / Notification SMTP
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=test_user
SMTP_PASS=test_pass
