# Server Configuration
PORT=5000
FRONTEND_URL=http://localhost:5173

# Database
MONGO_URI=mongodb://localhost:27017/flexify

# Authentication
JWT_SECRET=your_jwt_secret_here

# Email Configuration (Nodemailer)
# For Gmail: host=smtp.gmail.com, port=587, user=your_email, pass=app_password
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password_here

# Google Auth (Optional)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=https://flexify-rental-production.up.railway.app/api/auth/google/callback

# PayHere Integration
PAYHERE_MERCHANT_ID=your_merchant_id
PAYHERE_MERCHANT_SECRET=your_merchant_secret
PAYHERE_NOTIFY_URL=https://your-api.com/api/owner/payhere-notify
PAYHERE_RETURN_URL=https://flexify-rental-production.up.railway.app/dashboard?payment=success
PAYHERE_CANCEL_URL=https://flexify-rental-production.up.railway.app/dashboard?payment=cancel
PAYHERE_ENV=sandbox
BACKEND_URL=https://flexify-rental-production.up.railway.app
